    {
      "name": "2. Миграция и проверка",
      "item": [
        {
          "name": "Run migration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Report has all counters\", () => {",
                  "  [\"usersRead\", \"usersInserted\", \"usersUpdated\", \"usersDeleted\", \"ordersRead\", \"ordersInserted\", \"ordersUpdated\", \"ordersDeleted\"].forEach(k => pm.expect(body).to.have.property(k));",
                  "});",
                  "pm.test(\"Source users were read\", () => pm.expect(body.usersRead).to.be.at.least(2));",
                  "pm.test(\"Source orders were read\", () => pm.expect(body.ordersRead).to.be.at.least(4));",
                  "pm.collectionVariables.set(\"lastUsersInserted\", body.usersInserted);",
                  "pm.collectionVariables.set(\"lastOrdersInserted\", body.ordersInserted);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{migrationBaseUrl}}/api/v1/migration/run",
              "host": ["{{migrationBaseUrl}}"],
              "path": ["api", "v1", "migration", "run"]
            }
          },
          "response": []
        },
        {
          "name": "Migration status after",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"All Oracle orders are managed in PostgreSQL\", () => pm.expect(body.targetManagedOrders).to.eql(body.sourceOrders));",
                  "pm.test(\"All Oracle users are managed in PostgreSQL\", () => pm.expect(body.targetManagedUsers).to.eql(body.sourceUsers));",
                  "pm.test(\"PostgreSQL seeds are preserved\", () => pm.expect(body.targetUsers).to.be.at.least(body.sourceUsers + 2));",
                  "pm.collectionVariables.set(\"usersAfterFirstRun\", body.targetUsers);",
                  "pm.collectionVariables.set(\"ordersAfterFirstRun\", body.targetOrders);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{migrationBaseUrl}}/api/v1/migration/status",
              "host": ["{{migrationBaseUrl}}"],
              "path": ["api", "v1", "migration", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Verify migrated users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const admin = body.content.find(u => u.username === \"oracle_admin\");",
                  "const reader = body.content.find(u => u.username === \"oracle_reader\");",
                  "pm.test(\"oracle_admin migrated\", () => pm.expect(admin).to.be.an(\"object\"));",
                  "pm.test(\"oracle_reader migrated\", () => pm.expect(reader).to.be.an(\"object\"));",
                  "pm.test(\"Source IDs were remapped\", () => {",
                  "  pm.expect(admin.id).to.not.eql(1);",
                  "  pm.expect(reader.id).to.not.eql(2);",
                  "});",
                  "if (admin) pm.collectionVariables.set(\"oracleAdminTargetId\", admin.id);",
                  "if (reader) pm.collectionVariables.set(\"oracleReaderTargetId\", reader.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{postgresBaseUrl}}/api/v1/postgres/get-users?page=0&size=20&sort=id",
              "host": ["{{postgresBaseUrl}}"],
              "path": ["api", "v1", "postgres", "get-users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "id" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify migrated orders and FK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const byNumber = n => body.content.find(o => o.orderNumber === n);",
                  "const o1 = byNumber(\"ORD-ORACLE-1001\");",
                  "const o3 = byNumber(\"ORD-ORACLE-1003\");",
                  "pm.test(\"All 4 source orders exist\", () => {",
                  "  [\"ORD-ORACLE-1001\", \"ORD-ORACLE-1002\", \"ORD-ORACLE-1003\", \"ORD-ORACLE-1004\"].forEach(n => pm.expect(byNumber(n)).to.be.an(\"object\"));",
                  "});",
                  "pm.test(\"Order 1001 belongs to oracle_admin\", () => pm.expect(o1.userId).to.eql(Number(pm.collectionVariables.get(\"oracleAdminTargetId\"))));",
                  "pm.test(\"Order 1003 belongs to oracle_reader\", () => pm.expect(o3.userId).to.eql(Number(pm.collectionVariables.get(\"oracleReaderTargetId\"))));",
                  "pm.test(\"Amount and status are preserved\", () => {",
                  "  pm.expect(o1.amount).to.eql(1299.9);",
                  "  pm.expect(o1.status).to.eql(\"NEW\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{postgresBaseUrl}}/api/v1/postgres/get-orders?page=0&size=20&sort=id",
              "host": ["{{postgresBaseUrl}}"],
              "path": ["api", "v1", "postgres", "get-orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "id" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Идемпотентность",
      "item": [
        {
          "name": "Run migration again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"No duplicate users\", () => pm.expect(body.usersInserted).to.eql(0));",
                  "pm.test(\"No duplicate orders\", () => pm.expect(body.ordersInserted).to.eql(0));",
                  "pm.test(\"Nothing was deleted on idempotent run\", () => {",
                  "  pm.expect(body.usersDeleted).to.eql(0);",
                  "  pm.expect(body.ordersDeleted).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{migrationBaseUrl}}/api/v1/migration/run",
              "host": ["{{migrationBaseUrl}}"],
              "path": ["api", "v1", "migration", "run"]
            }
          },
          "response": []
        },
        {
          "name": "Counts did not change",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const usersBefore = Number(pm.collectionVariables.get(\"usersAfterFirstRun\"));",
                  "const ordersBefore = Number(pm.collectionVariables.get(\"ordersAfterFirstRun\"));",
                  "pm.test(\"User count unchanged\", () => pm.expect(body.targetUsers).to.eql(usersBefore));",
                  "pm.test(\"Order count unchanged\", () => pm.expect(body.targetOrders).to.eql(ordersBefore));"
