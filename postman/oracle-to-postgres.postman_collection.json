              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"All counters are present\", () => {",
                  "  [\"sourceUsers\", \"targetUsers\", \"targetManagedUsers\", \"sourceOrders\", \"targetOrders\", \"targetManagedOrders\"].forEach(k => pm.expect(body).to.have.property(k));",
                  "});",
                  "pm.test(\"Source has seed data\", () => {",
                  "  pm.expect(body.sourceUsers).to.be.at.least(2);",
                  "  pm.expect(body.sourceOrders).to.be.at.least(4);",
                  "});",
                  "pm.collectionVariables.set(\"sourceUsers\", body.sourceUsers);",
                  "pm.collectionVariables.set(\"sourceOrders\", body.sourceOrders);",
                  "pm.collectionVariables.set(\"targetUsersBeforeRun\", body.targetUsers);",
                  "pm.collectionVariables.set(\"targetOrdersBeforeRun\", body.targetOrders);"
                ]
              }
