{
  "info": {
    "_postman_id": "d4a9e2f1-7c3b-4b8e-9f1a-2c6d8e0b4a71",
    "name": "Oracle → PostgreSQL: schema migration",
    "description": "Проверка module-schema-migration: preview DDL, apply, status и идемпотентный повторный apply. Перед запуском module-schema-migration должен быть доступен на 8084.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Schema migration health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Schema migration app is UP\", () => pm.expect(body.status).to.eql(\"UP\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/actuator/health",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Status before",
      "item": [
        {
          "name": "Schema status before",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Target schema is auto_migration\", () => pm.expect(body.targetSchema).to.eql(\"auto_migration\"));",
                  "pm.test(\"Status has all counters\", () => {",
                  "  [\"sourceTables\", \"targetTables\", \"missingTables\", \"missingColumns\", \"valid\"].forEach(k => pm.expect(body).to.have.property(k));",
                  "});",
                  "pm.collectionVariables.set(\"missingTablesBefore\", body.missingTables);",
                  "pm.collectionVariables.set(\"missingColumnsBefore\", body.missingColumns);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/api/v1/schema-migration/status",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["api", "v1", "schema-migration", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Preview",
      "item": [
        {
          "name": "Preview DDL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Target schema is auto_migration\", () => pm.expect(body.targetSchema).to.eql(\"auto_migration\"));",
                  "pm.test(\"DDL is a non-empty list\", () => {",
                  "  pm.expect(body.ddl).to.be.an(\"array\");",
                  "  pm.expect(body.ddl.length).to.be.at.least(1);",
                  "});",
                  "pm.test(\"Every DDL step has sql\", () => {",
                  "  body.ddl.forEach(step => pm.expect(step.sql).to.be.a(\"string\"));",
                  "});",
                  "pm.collectionVariables.set(\"previewStatements\", body.statements);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/api/v1/schema-migration/preview",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["api", "v1", "schema-migration", "preview"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Apply",
      "item": [
        {
          "name": "Apply schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Schema migration succeeded\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"At least one statement was applied\", () => pm.expect(body.appliedStatements).to.be.at.least(1));",
                  "pm.test(\"Applied count matches total\", () => pm.expect(body.appliedStatements).to.eql(body.totalStatements));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/api/v1/schema-migration/apply",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["api", "v1", "schema-migration", "apply"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Status after",
      "item": [
        {
          "name": "Schema status after",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Schema is valid\", () => pm.expect(body.valid).to.eql(true));",
                  "pm.test(\"No missing tables\", () => pm.expect(body.missingTables).to.eql(0));",
                  "pm.test(\"No missing columns\", () => pm.expect(body.missingColumns).to.eql(0));",
                  "pm.test(\"Target has tables\", () => pm.expect(body.targetTables).to.be.at.least(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/api/v1/schema-migration/status",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["api", "v1", "schema-migration", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Idempotency",
      "item": [
        {
          "name": "Apply schema again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Second apply succeeded\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"No statement failed\", () => pm.expect(body.appliedStatements).to.eql(body.totalStatements));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/api/v1/schema-migration/apply",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["api", "v1", "schema-migration", "apply"]
            }
          },
          "response": []
        },
        {
          "name": "Final schema status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Schema is still valid\", () => pm.expect(body.valid).to.eql(true));",
                  "pm.test(\"No missing tables after second apply\", () => pm.expect(body.missingTables).to.eql(0));",
                  "pm.test(\"No missing columns after second apply\", () => pm.expect(body.missingColumns).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{schemaMigrationBaseUrl}}/api/v1/schema-migration/status",
              "host": ["{{schemaMigrationBaseUrl}}"],
              "path": ["api", "v1", "schema-migration", "status"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "schemaMigrationBaseUrl", "value": "http://localhost:8084" }
  ]
}
